<포인터> 
포인터 = 변수의 주소를 저장하는 변수. 
기능 : 배열/문자열을 함수로 전달함 > 함수에서 원본 데이터를 수 가능

1. &x면 주소, *p 하면 값.
= &는 주소를 얻고, *는 값을 꺼낸다. 

&x = x의 주소
int* p = &x ; p에 x의 주소를 저장하면 
    p 는 x의 주소 
    *p는 x의 주소에 들어 있는 값 = p가 가리키는 곳의 값 
선언할 때는 포인터 타입을 표시함. 
    그 외는 역참조 = 포인터가 가리키는 값 

ex)
x = 5
&x = 1000
p = 1000
*p = 5

2. 선언 방법
int* p = 정수를 가리키는 포인터
char*p= 문자를 가리키는 포인터 
double* p= 실수를 가리키는 포인터 
만능포인터 void* = 타입을 모를 때 > 뭐든 가리킬 수 있음. 
NULL 선언 int *p = NULL; 아무것도 안 가리키는 걸로 초기화 시켜놓고

3. 포인터와 배열
int arr[3] = {1,2,3}; / 정수형들이 담긴 배열
int *p = arr; 
    배열 이름 = 첫 원소 주소 
    >> 포인터는 arr[0] 이 있는 주소를 가리키고 있음
*p = arr[0]
*(p+1) = arr[1]
p[2] = arr[2] / 포인터도 [] 사용할 수 있음.

4. 포인터와 문자열
char* s = "hello" // 문자열은 사실 char 포인터
s[0] = 'h' // 작은 따옴표와 큰 따옴표 주의. 
수정 가능 ) char s1[] = "hello" > s1[0] = 'H' 로 하면 수정 가능
수정 불가 
    char* s2 = "hello" > s2[0] = 'H' 로 하면 수정 불가 = 읽기 전용 영역임 
    수정하려면 malloc으로 새 공간을 만들고 복사해야 함
    char* 함수이름(const char* my_string) 
    >> 문자열을 못 바꾼다는 기호 = const

<문자열 관련 함수>
strlen(s) : 문자열 길이 > '\0' 제외
strcmp(a,b) : 문자열 끼리 비교 > if (strcmp(a, b) == 0) 이면 같은 것. 
    정리) 문자열 포인터끼리는 == 불가 : 포인터는 주소값을 비교하기 때문에 
strcpy(dst, src) : 문자열 복사 / src(원본) -> dst(복사본 : 붙여넣을 곳)
strcat(a,b) : a 뒤에 b를 이어 붙이기
strstr(a,b) : b가 a에 있는지 찾기 / NULL 이면 없는 것 
strchr(s, 'x') : 특정 문자 찾기 / 

5. 동적 메모리 할당
int* p = (int*)malloc(sizeof(int) * 크기) 
    > p라는 포인터에 int 크기만큼 공간 할당
char* p = (char*)malloc(sizeof(char) * (크기+1)) 
    +1 은 '\0'을 위한 공간 
    > p[마지막 공간] = '\0' // char 타입에만.
이차원 배열
    int** answer = (int**)malloc(sizeof(int*) * row); : 행
    for (int i = 0; i < row; i++) {
        answer[i] = (int*)malloc(sizeof(int) * col); : 열 
}

// 접근: answer[행][열]

6. 함수 인자로 전달
void change(int *p) {
    *p = 100;
}
int x = 5;
change(&x);
    >> 실행결과 : x = 100

7. 헤더파일 정리
#include <stdio.h>     // printf, sprintf
#include <stdlib.h>    // malloc, free, qsort, atoi
#include <string.h>    // strlen, strcmp, strcpy, strstr
#include <stdbool.h>   // bool, true, false
#include <ctype.h>     // isdigit, toupper
#include <math.h>      // sqrt, pow (필요시)

8. 함수 추가 
#include <ctype.h>
    isdigit('5')   // 숫자면 참
    isalpha('a')   // 알파벳이면 참
    toupper('a')   // 소문자를 대문자로 
    tolower('A')   // 대문자를 소문자로 

#include <stdlib.h>
    qsort(배열, 개수, sizeof(원소), cmp)   // 정렬
    atoi("123")    // 문자열 → 정수 (123)

#include <stdio.h>
    sprintf(buf, "%d", 123)   // 정수 → 문자열

9. 
숫자로 된 문자열인가?
    (my_string[i] >= '0' && my_string[i] <= '9') 
    if (isdigit(my_string[i]))
정렬 qsort(배열, 개수, sizeof(원소), cmp)
    int cmp(const void*a, const void*b)
    오름차순 : return *(int*)a-*(int*)b; 
    내림차순 : return *(int*)b-*(int*)a;
문자열과 숫자 
    my_string[i] - '0'  (문자 1개를 정수로)
        = 문자열 전체를 정수로:  atoi("123")   // 타입 자동 
    5 + '0'    // '5'
        => sprintf(buf, "%d", 123);  (결과를 담을 문자열, "%d", 문자열로 바꿀 정수)
    'A' + 32    // 대문자 → 소문자
    'a' - 32    // 소문자 → 대문자
아스키코드
    '0'~'9' : 48~57
    'A'~'Z' : 65~90
    'a'~'z' : 97~122