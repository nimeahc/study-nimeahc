[c언어 정리]

%d 정수
%f 실수
%lf 실수 double 형 (파이썬에서 float : float보다 비트가 더 큼) 
%c 문자 하나 : 작은 따옴표 
%s 문자열 : 큰 따옴표 

#include <stdio.h>

int main(void) {
     printf("%d \n", 3);
     return 0;
}

